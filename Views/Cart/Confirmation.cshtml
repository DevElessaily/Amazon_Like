@model portofolio3.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4 text-center">
                <div class="display-5 mb-2">✔</div>
                <h3 class="mb-1">Thank you for your order!</h3>
                <p class="text-muted mb-4">
                    Order <strong>#@Model.Id</strong> was placed on @Model.OrderDate.ToString("g") and is now
                    <span class="badge rounded-pill text-bg-warning">@Model.Status</span>.
                </p>

                <h5 class="text-start mb-2">Order summary</h5>
                <div class="border rounded p-3 text-start mb-3">
                    @foreach (var item in Model.Items)
                    {
                        var img = item.Product.Images.FirstOrDefault()?.ImageUrl ?? "/images/products/default.svg";
                        <div class="d-flex gap-3 align-items-center mb-2">
                            <img src="@img" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:6px" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@item.Product.Name</div>
                                <div class="text-muted small">@item.Quantity &times; $@item.UnitPrice.ToString("N2")</div>
                            </div>
                            <div class="fw-semibold">$@((item.Quantity * item.UnitPrice).ToString("N2"))</div>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fs-5">
                        <span>Total</span>
                        <span class="fw-bold">$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>

                <div class="text-start mb-4">
                    <div class="text-muted small">Shipping to</div>
                    <div>@Model.ShippingAddress</div>
                </div>

                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Continue shopping</a>
            </div>
        </div>
    </div>
</div>