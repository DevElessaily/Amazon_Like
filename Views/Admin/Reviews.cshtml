@model ICollection<portofolio3.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Reviews</h2>
    <span class="text-muted">@Model.Count review(s)</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No reviews yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>User</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.Rating <= 2 ? "table-danger" : "")">
                        <td>@(r.Product?.Name ?? "—") <span class="text-muted small">#@r.ProductId</span></td>
                        <td>@(r.User?.Name ?? "—")</td>
                        <td>
                            <span class="text-warning">@(new string('★', Math.Max(0, Math.Min(5, r.Rating))))</span>
                            <span class="text-muted">@(new string('☆', Math.Max(0, 5 - r.Rating)))</span>
                            <span class="small text-muted ms-1">@r.Rating/5</span>
                        </td>
                        <td class="text-wrap" style="max-width:360px">@(r.Comment ?? "—")</td>
                        <td>@r.CreatedAt.ToString("g")</td>
                        <td class="text-end">
                            <form asp-action="DeleteReview" asp-route-id="@r.Id" method="post"
                                  onsubmit="return confirm('Delete this review?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}