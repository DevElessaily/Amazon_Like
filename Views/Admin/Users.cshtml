@model ICollection<portofolio3.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Users</h2>
    <span class="text-muted">@Model.Count account(s)</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No user accounts yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Name</td>
                        <td>@u.Email</td>
                        <td>@(u.Phone ?? "—")</td>
                        <td>@u.CreatedAt.ToString("g")</td>
                        <td class="text-end">
                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post"
                                  onsubmit="return confirm('Delete this account?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}