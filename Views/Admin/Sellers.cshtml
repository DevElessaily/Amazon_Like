@model ICollection<portofolio3.Models.Seller>

@{
    ViewData["Title"] = "Sellers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Sellers</h2>
    <span class="text-muted">@Model.Count seller(s), @Model.Count(s => !s.IsApproved) pending</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No sellers yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Owner</th>
                    <th>Shop</th>
                    <th>Contact</th>
                    <th class="text-center">Products</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.FullName</td>
                        <td>@s.ShopName</td>
                        <td>
                            <div>@s.Email</div>
                            <div class="text-muted small">@(s.Phone ?? "—")</div>
                        </td>
                        <td class="text-center">@s.Products.Count</td>
                        <td>
                            @if (s.IsApproved)
                            {
                                <span class="badge rounded-pill text-bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-warning">Pending</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="SellerDetails" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm">View</a>
                                @if (!s.IsApproved)
                                {
                                    <form asp-action="ApproveSeller" asp-route-id="@s.Id" method="post">
                                        <button type="submit" class="btn btn-outline-success btn-sm">Approve</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="RejectSeller" asp-route-id="@s.Id" method="post">
                                        <button type="submit" class="btn btn-outline-warning btn-sm">Suspend</button>
                                    </form>
                                }
                                <form asp-action="DeleteSeller" asp-route-id="@s.Id" method="post"
                                      onsubmit="return confirm('Delete this seller and all their products?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}