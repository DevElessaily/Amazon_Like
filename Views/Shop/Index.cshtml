@model ICollection<portofolio3.Models.Product>

@{
    ViewData["Title"] = "Products";
    var cats = ViewBag.Categories as ICollection<portofolio3.Models.Category> ?? new List<portofolio3.Models.Category>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Products</h2>
    <span class="text-muted">@Model.Count item(s)</span>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Search products..." />
    </div>
    <div class="col-md-2">
        <select name="categoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in cats)
            {
                <option value="@c.Id" selected="@(selectedCategory == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="text" name="brand" class="form-control" value="@ViewBag.Brand" placeholder="Shop / brand" />
    </div>
    <div class="col-md-2">
        <select name="sortBy" class="form-select">
            <option value="">Sort: A-Z</option>
            <option value="price_asc" selected="@((string?)ViewBag.SortBy == "price_asc")">Price: low to high</option>
            <option value="price_desc" selected="@((string?)ViewBag.SortBy == "price_desc")">Price: high to low</option>
            <option value="newest" selected="@((string?)ViewBag.SortBy == "newest")">Newest</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in Model)
        {
            var img = p.Images.FirstOrDefault()?.ImageUrl ?? "/images/products/default.svg";
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@img" class="card-img-top" style="height:180px;object-fit:cover" alt="@p.Name">
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title mb-1">@p.Name</h6>
                        <p class="card-text text-muted small mb-1">@(p.Category?.Name ?? "—")</p>
                        <p class="card-text text-muted small mb-2">@p.Description</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold">$@p.Price.ToString("N2")</span>
                                @if (p.Stock > 0)
                                {
                                    <span class="text-muted small">@p.Stock in stock</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Out of stock</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">@p.Seller?.ShopName</small>
                                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@p.Id">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}