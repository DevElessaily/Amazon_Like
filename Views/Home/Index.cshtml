@model ICollection<portofolio3.Models.Product>

@{
    ViewData["Title"] = "Storefront";
    var cats = ViewBag.Categories as ICollection<portofolio3.Models.Category> ?? new List<portofolio3.Models.Category>();
}

<div class="row mb-3">
    <div class="col">
        <h2>Shop</h2>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Search products..." />
    </div>
    <div class="col-md-3">
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in cats)
            {
                <option value="@c.Id" selected="@((string?)ViewBag.CurrentCategory == c.Id.ToString())">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="">Sort: recommended</option>
            <option value="price-asc" selected="@((string?)ViewBag.CurrentSort == "price-asc")">Price: low to high</option>
            <option value="price-desc" selected="@((string?)ViewBag.CurrentSort == "price-desc")">Price: high to low</option>
            <option value="newest" selected="@((string?)ViewBag.CurrentSort == "newest")">Newest</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in Model)
        {
            var img = p.Images.FirstOrDefault()?.ImageUrl ?? "/images/products/default.svg";
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@img" class="card-img-top" style="height:180px;object-fit:cover" alt="@p.Name" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@p.Name</h6>
                        <p class="card-text text-muted small mb-1">@p.Category?.Name</p>
                        <p class="card-text text-muted small mb-2">@p.Description</p>
                        <div class="mt-auto">
                            <span class="fw-bold">$@p.Price.ToString("0.00")</span>
                            <span class="text-muted small ms-2">@p.Stock in stock</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">@p.Seller?.ShopName</small>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-controller="Shop" asp-route-id="@p.Id">View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}