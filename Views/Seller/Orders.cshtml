@model ICollection<portofolio3.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    var sellerId = (int)ViewBag.SellerId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Orders</h2>
    <span class="text-muted">@Model.Count order(s) with your products</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No orders for your products yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Your items</th>
                    <th>Your total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var lines = o.Items
                        .Where(i => i.Product.SellerId == sellerId)
                        .ToList();
                    var sellerTotal = lines.Sum(i => i.Quantity * i.UnitPrice);
                    <tr>
                        <td>@o.Id</td>
                        <td>
                            <div>@(o.User?.Name ?? "—")</div>
                            <div class="text-muted small">@(o.User?.Email ?? "")</div>
                        </td>
                        <td>@o.OrderDate.ToString("g")</td>
                        <td>
                            @foreach (var it in lines)
                            {
                                <div>@it.Product.Name &times; @it.Quantity</div>
                            }
                        </td>
                        <td>$@sellerTotal.ToString("N2")</td>
                        <td>
                            <span class="badge rounded-pill text-bg-@(o.Status switch { "Delivered" => "success", "Refunded" => "danger", "Pending" => "warning", "Cancelled" => "secondary", _ => "secondary" })">@o.Status</span>
                        </td>
                        <td class="text-end">
                            @if (o.Status == "Pending")
                            {
                                <form asp-action="MarkOrderDelivered" asp-route-id="@o.Id" method="post">
                                    <button type="submit" class="btn btn-outline-success btn-sm">Mark shipped/delivered</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}